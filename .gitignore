# Private-tier data must never land in this PUBLIC repo.
# tiara-data.json lives in the private `tiara` repo and is read via the
# authenticated Contents API. Backups and exports of it are never committed here.
backups/
tiara-data*.json
*.backup-*.json

# Stale duplicates left by editors and one-off scripts
*.pre-board-backup

.DS_Store

# Compliance snapshot now lives in the private `tiara` repo (#56), fetched via the token.
compliance.json

# TestFlight status now lives in the private `tiara` repo (#56), fetched via the token.
release-status.json

# The enforcement layer's runtime files (tiara-site#100). tree-fingerprint.sh hashes untracked
# non-ignored files to record that `make verify` passed on the current code, so any of these left
# tracked moves the fingerprint on its own and .claude/.verify-pass never matches (BOOT-115).
.claude/.verify-pass
.verify-pass
.claude/.turn-start
.claude/.turn-dirty
.claude/.last-dirty
.claude/.last-seen
.claude/drift.log
.claude/gate.log
.gate/
.artifacts/
